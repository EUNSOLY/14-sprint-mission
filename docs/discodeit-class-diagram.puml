@startuml discodeit-class-diagram
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members
left to right direction

' ===================== com.sprint.mission.discodeit =====================
package "com.sprint.mission.discodeit" #E8F1FF {
    class DiscodeitApplication
    class JavaApplication
}

' ===================== com.sprint.mission.discodeit.common =====================
package "com.sprint.mission.discodeit.common" #EAF7EA {
    class FileStorageUtil
}

' ===================== com.sprint.mission.discodeit.entity =====================
package "com.sprint.mission.discodeit.entity" #F3EAFB {
    abstract class BaseEntity

    class User
    class BinaryContent
    class Message
    class UserStatus
    class Channel
    class ReadStatus

    enum ChannelType {
        PUBLIC
        PRIVATE
    }

    enum UserStatusType {
        ONLINE
        OFFLINE
        - status
    }

    BaseEntity <|-- User
    BaseEntity <|-- BinaryContent
    BaseEntity <|-- Message
    BaseEntity <|-- UserStatus
    BaseEntity <|-- Channel
    BaseEntity <|-- ReadStatus

    User "1" -- "0..1" BinaryContent : profile
    User "1" -- "0..*" Message : sending
    User "1" -- "1" UserStatus : status
    User "1" -- "0..*" ReadStatus : reads

    BinaryContent "1" -- "0..*" Message : attachments

    Message "0..*" -- "1" Channel : in
    Channel "1" -- "0..*" ReadStatus : read in
}

' ===================== com.sprint.mission.discodeit.dto =====================
package "com.sprint.mission.discodeit.dto" #E8F1FF {
    abstract class IdRequestDto

    class UserIdRequestDto
    class ChannelIdRequestDto
    class MessageIdRequestDto
    class ReadStatusIdRequestDto
    class UserStatusIdRequestDto
    class BinaryContentIdRequestDto

    IdRequestDto <|-- UserIdRequestDto
    IdRequestDto <|-- ChannelIdRequestDto
    IdRequestDto <|-- MessageIdRequestDto
    IdRequestDto <|-- ReadStatusIdRequestDto
    IdRequestDto <|-- UserStatusIdRequestDto
    IdRequestDto <|-- BinaryContentIdRequestDto

    class LoginRequestDto
    class UserCreateRequestDto
    class UserUpdateRequestDto
    class UserResponseDto

    class UserStatusCreateRequestDto
    class UserStatusUpdateRequestDto

    class ChannelResponseDto
    class ChannelUpdateRequestDto
    class PublicChannelCreateRequestDto
    class PrivateChannelCreateRequestDto

    class MessageCreateRequestDto
    class MessageUpdateRequestDto
    class MessageResponseDto

    class ReadStatusCreateRequestDto
    class ReadStatusUpdateRequestDto

    class
    class BinaryContentResponseDto
}

