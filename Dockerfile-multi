# 스테이지1. 빌드 환경
FROM amazoncorretto:17 AS build-stage
WORKDIR /app

# 1. Java 빌드를 위한 의존성 파일 복사
# - gradlew : Gradle을 실행하는 스크립트
# - gradle : Gradle Wrapper 설정 폴더 (사용할 Gradle 버전 정보와 실행용 jar 포함)
# - build.gradle : 의존성, 플러그인, 자바 버전 등 빌드 설정
# - settings.gradle : 프로젝트 이름과 모듈 구성 설정
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./
RUN chmod +x gradlew && ./gradlew dependencies --no-daemon


# 2. 빌드 대상 소스코드 복사
# - 의존성 파일과 따로 복사하는 이유 : 자주 바뀌지 않는 의존성 레이어를 캐싱해서,
#   소스코드만 바뀌었을 때 의존성을 다시 받지 않고 빠르게 빌드하기 위함
COPY src src
RUN ./gradlew bootJar -x test --no-daemon

# 두번째 단계
FROM amazoncorretto:17-alpine
WORKDIR /app

ARG PROJECT_NAME=discodeit
ARG PROJECT_VERSION=1.2-M8
ENV JVM_OPTS=""

# 빌드 단계에서 jar 하나만 가져옴
COPY --from=build-stage /app/build/libs/${PROJECT_NAME}-${PROJECT_VERSION}.jar app.jar

EXPOSE 80

ENTRYPOINT ["sh", "-c", "exec java $JVM_OPTS -jar app.jar"]

